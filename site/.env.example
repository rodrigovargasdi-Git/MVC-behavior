# Kopieren nach .env und ausfüllen. Werte werden beim Build (npm run build) fest eingebaut.

# Ziel-URL des Kontaktformulars (POST). Leer lassen = kein Formular, stattdessen
# E-Mail-/Kontakt-Hinweis auf /kontakt/. Beispiele:
#   PUBLIC_FORM_ENDPOINT=/kontakt.php                (PHP-Mailer auf demselben EU-Host)
#   PUBLIC_FORM_ENDPOINT=https://formular-dienst.eu/f/abc123   (EU-Formulardienst mit AVV)
# Der Endpunkt muss: Felder name, email, anliegen, region, nachricht, datenschutz annehmen,
# das Honeypot-Feld "website" verwerfen, serverseitig prüfen und
#   - bei normalem POST auf /kontakt/danke/ weiterleiten (303) bzw.
#   - bei "Accept: application/json" mit HTTP 2xx antworten (sonst zeigt die Seite einen Fehler).
PUBLIC_FORM_ENDPOINT=

# true = Seite wird nicht indexiert (robots.txt sperrt alles, <meta name="robots" content="noindex">).
# Für Test-/Vorschau-Deployments mit Platzhaltern auf true setzen.
PUBLIC_NOINDEX=false

# Finale Domain (optional, sonst Platzhalter aus astro.config.mjs).
SITE_URL=
