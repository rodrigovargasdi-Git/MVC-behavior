---
import { site, confirmed } from '../content/site';
import { content, crumbOf } from '../content/index';
import { hasPage, pathFor, pathOrHome, type Locale, type PageKey } from '../i18n/routes';
import { plain } from '../lib/rich';
import R from './R.astro';
import LangSwitch from './LangSwitch.astro';

interface Props { locale: Locale; routeKey?: PageKey }
const { locale, routeKey } = Astro.props;
const ui = content[locale].ui;
const email = confirmed(site.contact.email);
const year = new Date().getFullYear();
const link = (key: string) => ({ href: pathFor(key, locale)!, label: plain(crumbOf(locale, key) ?? key) });
const families = ui.footer.familyLinks.filter((k) => hasPage(k, locale)).map(link);
const more = ui.footer.moreLinks.filter((k) => hasPage(k, locale)).map(link);
const legal = (['imprint', 'privacy'] as const).filter((k) => hasPage(k, locale)).map(link);
---
<footer class="site-footer bg-forest on-dark">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="footer-name">{site.brand.name}</p>
        <p class="muted small">{site.brand.descriptor[locale]}</p>
        {site.brand.status && <p class="small footer-status"><R t={site.brand.status} /></p>}
        <p class="small muted footer-disclaimer">{ui.footer.disclaimer}</p>
      </div>

      {families.length > 0 && (
        <nav aria-label={ui.footer.families}>
          <p class="footer-head">{ui.footer.families}</p>
          <ul>{families.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </nav>
      )}

      {more.length > 0 && (
        <nav aria-label={ui.footer.more}>
          <p class="footer-head">{ui.footer.more}</p>
          <ul>{more.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </nav>
      )}

      <div>
        <p class="footer-head">{ui.footer.contact}</p>
        <ul>
          <li>{email ? <a href={`mailto:${email}`}>{email}</a> : <span class="small"><R t={site.contact.email} /></span>}</li>
          <li><a href={pathOrHome('contact', locale)}>{ui.footer.contactLink}</a></li>
        </ul>
        <p class="footer-head" style="margin-top:1.5rem;">{ui.langLabel}</p>
        <LangSwitch locale={locale} routeKey={routeKey} class="footer-lang" />
      </div>
    </div>

    <div class="footer-bottom">
      <p class="small">© {year} {site.brand.name}</p>
      {legal.length > 0 && (
        <nav aria-label={ui.footer.legal}>
          <ul class="legal-links">{legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </nav>
      )}
      <div class="footer-notes">
        <p class="small muted">{ui.footer.noCookies}</p>
        {site.photosAreSamples && <p class="small muted samples-note" data-photos="samples">{ui.footer.samples}</p>}
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding-block: 0 2rem; }
  .site-footer > .wrap { border-top: 1px solid var(--line-on-dark); padding-top: 3.5rem; }
  .footer-grid { display: grid; gap: 2.25rem; }
  @media (min-width: 720px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .footer-grid { grid-template-columns: 1.5fr 1fr 1fr 1fr; } }
  .footer-name { font-family: var(--font-serif); font-size: 1.5rem; line-height: 1.15; }
  .footer-brand > * + * { margin-top: 0.6rem; }
  .footer-status { max-width: 38ch; }
  .footer-disclaimer { max-width: 42ch; }
  .footer-head { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent-on-dark); margin-bottom: 0.5rem; }
  ul { list-style: none; margin: 0; padding: 0; }
  li a { display: inline-flex; align-items: center; min-height: 40px; padding-block: 0.35rem; color: var(--on-dark); text-decoration: underline; text-decoration-color: rgb(247 243 236 / 0.35); text-underline-offset: 0.3em; }
  li a:hover { color: var(--accent-on-dark); text-decoration-color: currentColor; }
  .footer-lang :global(a) { color: var(--on-dark-muted); text-decoration: none; }
  .footer-lang :global(a[aria-current='true']) { color: var(--on-dark); box-shadow: inset 0 0 0 1.5px var(--on-dark-muted); }
  .footer-lang :global(a:hover) { color: var(--on-dark); background: rgb(247 243 236 / 0.08); }
  .footer-bottom { margin-top: 3rem; padding-top: 1.25rem; border-top: 1px solid var(--line-on-dark); display: grid; gap: 0.5rem; align-items: start; }
  @media (min-width: 900px) { .footer-bottom { grid-template-columns: auto auto 1fr; gap: 2rem; } .footer-notes { text-align: right; } }
  .legal-links { display: flex; flex-wrap: wrap; gap: 0 1.5rem; }
  .legal-links a { font-weight: 700; min-height: 24px; padding-block: 0; }
  .samples-note { margin-top: 0.25rem; }
</style>
