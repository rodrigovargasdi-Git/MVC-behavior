---
import { site } from '../content/site';
import { content, crumbOf } from '../content/index';
import { hasPage, pathFor, pathOrHome, type Locale, type PageKey } from '../i18n/routes';
import { plain } from '../lib/rich';
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';

interface Props { locale: Locale; routeKey?: PageKey }
const { locale, routeKey } = Astro.props;
const ui = content[locale].ui;
const path = Astro.url.pathname;

const label = (key: string, fallback?: string) => fallback ?? plain(crumbOf(locale, key) ?? key);
const items = ui.nav
  .filter((i) => hasPage(i.key, locale))
  .map((i) => ({
    key: i.key,
    href: pathFor(i.key, locale)!,
    label: label(i.key, i.label),
    children: (i.children ?? [])
      .filter((c) => hasPage(c.key, locale))
      .map((c) => ({ key: c.key, href: pathFor(c.key, locale)!, label: label(c.key, c.label) })),
  }));
const inSection = (it: (typeof items)[number]) =>
  it.href === path || it.children.some((c) => c.href === path) || (path.startsWith(it.href) && it.key !== 'home');
const home = pathFor('home', locale) ?? '/';
const ctaHref = `${pathOrHome('contact', locale)}?anliegen=familie`;
const brandSub = site.brand.name.replace(site.brand.short, '').replace(/^[\s·|–-]+/, '').trim() || site.brand.descriptor[locale];
---
<header class="site-header">
  <div class="wrap header-bar">
    <a class="brand" href={home} aria-label={`${site.brand.name} – ${ui.home}`}>
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" width="38" height="38"><circle cx="20" cy="20" r="20" fill="#183b30"/><path d="M12 13.5l8 14 8-14" fill="none" stroke="#f7f3ec" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/><circle cx="29" cy="28" r="3.2" fill="#c9785f"/></svg>
      </span>
      <span class="brand-text">
        <span class="brand-name">{site.brand.short}</span>
        <span class="brand-sub">{brandSub}</span>
      </span>
    </a>

    <nav class="nav-desktop" aria-label={ui.navLabel}>
      <ul class="nav-list">
        {items.map((it, n) => (
          <li class:list={['nav-item', { 'has-sub': it.children.length > 1 }]}>
            <a href={it.href} class="nav-link" aria-current={it.href === path ? 'page' : undefined} data-section={inSection(it) ? '' : undefined}>{it.label}</a>
            {it.children.length > 1 && (
              <>
                <button class="sub-toggle" type="button" aria-expanded="false" aria-controls={`sub-${n}`} data-sub-toggle>
                  <span class="visually-hidden">{ui.subnavToggle} {it.label}</span>
                  <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <ul class="subnav" id={`sub-${n}`}>
                  {it.children.map((c) => (
                    <li><a href={c.href} aria-current={c.href === path ? 'page' : undefined}>{c.label}</a></li>
                  ))}
                </ul>
              </>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <LangSwitch locale={locale} routeKey={routeKey} class="lang-desktop" />
    <a class="btn btn-dark header-cta" href={ctaHref}>{ui.headerCta}</a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" data-menu-toggle>
      <span class="icon-open"><Icon name="menu" size={22} /></span>
      <span class="icon-close"><Icon name="close" size={22} /></span>
      <span class="menu-label">{ui.menu}</span>
    </button>
  </div>

  <nav id="mobile-nav" class="nav-mobile" aria-label={ui.navLabel} data-menu>
    <div class="wrap">
      <LangSwitch locale={locale} routeKey={routeKey} class="lang-mobile" />
      <ul>
        {items.map((it) => (
          <li>
            <a href={it.href} aria-current={it.href === path ? 'page' : undefined}>{it.label}</a>
            {it.children.length > 1 && (
              <ul class="sub">
                {it.children.filter((c) => c.href !== it.href).map((c) => (
                  <li><a href={c.href} aria-current={c.href === path ? 'page' : undefined}>{c.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <a class="btn btn-primary mobile-cta" href={ctaHref}>{ui.cta.call} <Icon name="arrow" /></a>
    </div>
  </nav>
</header>

<noscript>
  <style>@media (max-width: 1279px) { .nav-mobile { display: block !important; } .menu-toggle { display: none !important; } }</style>
</noscript>

<script>
  // Mobiles Menü
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (btn && menu) {
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('is-open', open);
      document.documentElement.classList.toggle('menu-open', open);
    };
    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        btn.focus();
      }
    });
    menu.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (next && !menu.contains(next) && next !== btn) setOpen(false);
    });
    matchMedia('(min-width: 1280px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
  }

  // Untermenüs (Disclosure-Muster): Button öffnet/schließt, Escape und Klick außerhalb schließen.
  const toggles = [...document.querySelectorAll<HTMLButtonElement>('[data-sub-toggle]')];
  const closeAll = (except?: HTMLButtonElement) =>
    toggles.forEach((t) => { if (t !== except) t.setAttribute('aria-expanded', 'false'); });
  toggles.forEach((t) => {
    t.addEventListener('click', () => {
      const open = t.getAttribute('aria-expanded') !== 'true';
      closeAll(t);
      t.setAttribute('aria-expanded', String(open));
    });
    t.parentElement?.addEventListener('focusout', (e) => {
      const next = (e as FocusEvent).relatedTarget as Node | null;
      if (next && !t.parentElement!.contains(next)) t.setAttribute('aria-expanded', 'false');
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = toggles.find((t) => t.getAttribute('aria-expanded') === 'true');
    if (open) { open.setAttribute('aria-expanded', 'false'); open.focus(); }
    document.documentElement.classList.add('sub-dismissed');
  });
  document.addEventListener('pointermove', () => document.documentElement.classList.remove('sub-dismissed'), { passive: true });
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.nav-item')) closeAll();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgb(247 243 236 / 0.95);
    border-bottom: 1px solid var(--line);
  }
  @supports (backdrop-filter: blur(8px)) {
    .site-header { background: rgb(247 243 236 / 0.86); backdrop-filter: blur(12px); }
  }
  .header-bar { display: flex; align-items: center; gap: 0.75rem; min-height: var(--header-h); }
  .brand { display: flex; align-items: center; gap: 0.7rem; text-decoration: none; min-height: 44px; margin-right: auto; }
  .brand-mark { flex: none; }
  .brand-text { display: grid; line-height: 1.1; }
  .brand-name { font-family: var(--font-serif); font-size: 1.3rem; letter-spacing: -0.01em; }
  .brand-sub { font-size: 0.66rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-muted); }

  .nav-desktop { display: none; }
  .nav-list { display: flex; gap: 0.1rem; list-style: none; margin: 0; padding: 0; }
  .nav-item { position: relative; display: flex; align-items: center; }
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 0.6rem;
    font-size: 0.93rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
  }
  .has-sub .nav-link { padding-right: 0.15rem; }
  .nav-link:hover { color: var(--accent); }
  .nav-link[aria-current='page'], .nav-link[data-section] { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: 0.5em; }
  .sub-toggle {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    border-radius: 6px;
  }
  .sub-toggle svg { transition: transform 0.2s ease; }
  .sub-toggle[aria-expanded='true'] svg { transform: rotate(180deg); }
  .subnav {
    display: none;
    position: absolute;
    top: calc(100% - 4px);
    left: -0.5rem;
    min-width: 17rem;
    list-style: none;
    margin: 0;
    padding: 0.6rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .subnav a {
    display: flex;
    align-items: center;
    min-height: 40px;
    padding: 0.35rem 0.75rem;
    border-radius: 10px;
    font-size: 0.93rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }
  .subnav a:hover { background: var(--sand); }
  .subnav a[aria-current='page'] { color: var(--accent); }
  .sub-toggle[aria-expanded='true'] + .subnav { display: block; }
  @media (hover: hover) and (pointer: fine) {
    :global(html:not(.sub-dismissed)) .nav-item:hover > .subnav { display: block; }
  }

  .header-cta { display: none; min-height: 44px; padding: 0.6rem 1.1rem; font-size: 0.88rem; white-space: nowrap; }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    min-width: 44px;
    padding: 0.5rem 0.9rem;
    border: 1.5px solid var(--forest);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
  }
  .menu-toggle .icon-close { display: none; }
  .menu-toggle[aria-expanded='true'] .icon-close { display: inline; }
  .menu-toggle[aria-expanded='true'] .icon-open { display: none; }

  .nav-mobile {
    display: none;
    border-top: 1px solid var(--line);
    background: var(--bg);
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .nav-mobile.is-open { display: block; }
  .nav-mobile ul { list-style: none; margin: 0; padding: 0; }
  .nav-mobile > .wrap { padding-block: 0.75rem 1.5rem; }
  .nav-mobile .lang-mobile { margin-bottom: 0.5rem; }
  .nav-mobile li a {
    display: flex;
    min-height: 48px;
    align-items: center;
    border-bottom: 1px solid var(--line);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--ink);
    text-decoration: none;
  }
  .nav-mobile .sub a { padding-left: 1.25rem; font-weight: 600; font-size: 1rem; color: var(--ink-muted); }
  .nav-mobile a[aria-current='page'] { color: var(--accent); text-decoration: underline; text-underline-offset: 0.35em; }
  .mobile-cta { margin-top: 1.25rem; width: 100%; }

  @media (max-width: 380px) { .brand-sub { letter-spacing: 0.1em; } .brand-mark svg { width: 32px; height: 32px; } }
  @media (min-width: 720px) { .header-cta { display: inline-flex; } }
  @media (min-width: 1280px) {
    .nav-desktop { display: block; }
    .menu-toggle, .nav-mobile, .nav-mobile.is-open { display: none; }
  }
</style>
