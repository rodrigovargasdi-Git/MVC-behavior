---
import { site } from '../content/site';
import { mainNav, cta } from '../lib/nav';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href;
const isSection = (href: string) => href !== '/' && path.startsWith(href) && path !== href;
---
<header class="site-header">
  <div class="wrap header-bar">
    <a class="brand" href="/" aria-label={`${site.brand.name} – zur Startseite`}>
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" width="40" height="40"><circle cx="20" cy="20" r="20" fill="#183b30"/><path d="M12 13.5l8 14 8-14" fill="none" stroke="#f6f1e8" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/><circle cx="29" cy="28" r="3.2" fill="#d96d58"/></svg>
      </span>
      <span class="brand-text">
        <span class="brand-name">{site.brand.name}</span>
        <span class="brand-sub">{site.brand.descriptor}</span>
      </span>
    </a>

    <nav class="nav-desktop" aria-label="Hauptnavigation">
      <ul>
        {mainNav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class:list={['nav-link', { 'is-section': isSection(item.href) }]}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="btn btn-dark header-cta" href={cta.familie.href}>{cta.familie.label}</a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" data-menu-toggle>
      <span class="icon-open"><Icon name="menu" size={22} /></span>
      <span class="icon-close"><Icon name="close" size={22} /></span>
      <span class="menu-label">Menü</span>
    </button>
  </div>

  <nav id="mobile-nav" class="nav-mobile" aria-label="Hauptnavigation mobil" data-menu>
    <div class="wrap">
      <ul>
        {mainNav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
            {'children' in item && item.children && (
              <ul class="sub">
                {item.children.map((c) => (
                  <li><a href={c.href} aria-current={isCurrent(c.href) ? 'page' : undefined}>{c.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <a class="btn btn-primary mobile-cta" href={cta.familie.href}>{cta.familie.label} <Icon name="arrow" /></a>
    </div>
  </nav>
</header>

<noscript>
  <style>@media (max-width: 1099px) { .nav-mobile { display: block !important; } .menu-toggle { display: none !important; } }</style>
</noscript>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (btn && menu) {
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('is-open', open);
      document.documentElement.classList.toggle('menu-open', open);
    };
    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        btn.focus();
      }
    });
    // Schließen, wenn der Fokus das Menü verlässt oder auf Desktop-Breite gewechselt wird.
    menu.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (next && !menu.contains(next) && next !== btn) setOpen(false);
    });
    matchMedia('(min-width: 1100px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgb(246 241 232 / 0.94);
    border-bottom: 1px solid var(--line);
  }
  @supports (backdrop-filter: blur(8px)) {
    .site-header { background: rgb(246 241 232 / 0.86); backdrop-filter: blur(10px); }
  }
  .header-bar { display: flex; align-items: center; gap: 1rem; min-height: var(--header-h); }
  .brand { display: flex; align-items: center; gap: 0.75rem; text-decoration: none; min-height: 44px; margin-right: auto; }
  .brand-mark { flex: none; }
  .brand-text { display: grid; line-height: 1.15; }
  .brand-name { font-weight: 800; font-size: 1rem; letter-spacing: -0.02em; }
  .brand-sub { font-size: 0.75rem; font-weight: 600; color: var(--ink-muted); }
  @media (max-width: 420px) { .brand-sub { display: none; } }

  .nav-desktop { display: none; }
  .nav-desktop ul { display: flex; gap: 0.25rem; list-style: none; margin: 0; padding: 0; }
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
  }
  .nav-link:hover { color: var(--accent); }
  .nav-link[aria-current='page'], .nav-link.is-section { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: 0.45em; }

  .header-cta { display: none; min-height: 44px; padding: 0.6rem 1.15rem; font-size: 0.9rem; }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    min-width: 44px;
    padding: 0.5rem 0.9rem;
    border: 1.5px solid var(--forest);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
  }
  .menu-toggle .icon-close { display: none; }
  .menu-toggle[aria-expanded='true'] .icon-close { display: inline; }
  .menu-toggle[aria-expanded='true'] .icon-open { display: none; }

  .nav-mobile {
    display: none;
    border-top: 1px solid var(--line);
    background: var(--bg);
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .nav-mobile.is-open { display: block; }
  .nav-mobile ul { list-style: none; margin: 0; padding: 0; }
  .nav-mobile > .wrap { padding-block: 0.5rem 1.5rem; }
  .nav-mobile a:not(.btn) {
    display: flex;
    min-height: 48px;
    align-items: center;
    border-bottom: 1px solid var(--line);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--ink);
    text-decoration: none;
  }
  .nav-mobile .sub a:not(.btn) { padding-left: 1.25rem; font-weight: 600; font-size: 1rem; color: var(--ink-muted); }
  .nav-mobile a[aria-current='page']:not(.btn) { color: var(--accent); text-decoration: underline; text-underline-offset: 0.35em; }
  .mobile-cta { margin-top: 1.25rem; width: 100%; }

  @media (min-width: 640px) { .header-cta { display: inline-flex; } }
  @media (min-width: 1100px) {
    .nav-desktop { display: block; }
    .menu-toggle, .nav-mobile, .nav-mobile.is-open { display: none; }
  }
</style>
