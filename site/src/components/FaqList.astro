---
/** Aufklappbare Fragen (details/summary). Antworten mit Mini-Auszeichnung. */
import type { FaqItem } from '../content/types';
import { localeFromPath } from '../i18n/routes';
import { resolveHref } from '../lib/rich';
import R from './R.astro';
interface Props { items: FaqItem[] }
const { items } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
---
<div class="faq-list">
  {items.map((f) => (
    <details id={f.id}>
      <summary>{f.q}</summary>
      <div class="faq-answer">
        {f.a.filter((p) => p.trim()).map((p) => <p><R t={p} /></p>)}
        {f.link && <p><a href={resolveHref(f.link.href, locale)}>{f.link.label}</a></p>}
      </div>
    </details>
  ))}
</div>
