---
interface Props { items: { name: string; href: string }[] }
const { items } = Astro.props;
---
<nav class="breadcrumbs wrap" aria-label="Brotkrumen">
  <ol>
    {items.map((it, i) => (
      <li>
        {i < items.length - 1 ? <a href={it.href}>{it.name}</a> : <span aria-current="page">{it.name}</span>}
      </li>
    ))}
  </ol>
</nav>
<style>
  .breadcrumbs { padding-top: 1.25rem; }
</style>
