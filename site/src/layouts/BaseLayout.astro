---
import '@fontsource-variable/manrope/wght.css';
import '@fontsource/dm-serif-display/latin-400.css';
import '@fontsource/dm-serif-display/latin-ext-400.css';
import '@fontsource/dm-serif-display/latin-400-italic.css';
import '@fontsource/dm-serif-display/latin-ext-400-italic.css';
import '../styles/global.css';
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import serifLatin from '@fontsource/dm-serif-display/files/dm-serif-display-latin-400-normal.woff2?url';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../content/site';
import { content, crumbOf } from '../content/index';
import { siteGraph, webPageLd, breadcrumbLd } from '../lib/jsonld';
import { plain } from '../lib/rich';
import {
  alternates,
  isActiveLocale,
  isNoindex,
  locales,
  localeFromPath,
  localeMeta,
  lookup,
  parentOf,
  pathFor,
  type Locale,
  type PageKey,
} from '../i18n/routes';

interface Crumb { name: string; href: string }
interface Props {
  /** Seitentitel ohne Marke, ≤ ~50 Zeichen (wird zu „… | Marija Vargas“). */
  title: string;
  /** Meta-Description, ≤ 155 Zeichen. */
  description: string;
  locale?: Locale;
  routeKey?: PageKey;
  /** Nur für Altseiten: explizite Brotkrumen ohne „Start“. Sonst aus dem Routen-Register. */
  breadcrumbs?: Crumb[];
  /** Zusätzliche JSON-LD-Knoten (Service, FAQPage …). */
  jsonLd?: object[];
  noindex?: boolean;
  ogType?: 'website' | 'profile';
}

const pathname = Astro.url.pathname;
const found = lookup(pathname);
const locale: Locale = Astro.props.locale ?? found?.locale ?? localeFromPath(pathname);
const key: PageKey | undefined = Astro.props.routeKey ?? found?.key;
const { title, description, breadcrumbs, jsonLd = [], ogType = 'website' } = Astro.props;
const ui = content[locale].ui;
const meta = localeMeta[locale];

const siteUrl = Astro.site ?? new URL('https://vargas-behavior.example');
const canonical = new URL(pathname, siteUrl).href;
const isHome = key === 'home';
const fullTitle = isHome ? plain(title) : `${plain(title)} | ${site.person.name}`;
const desc = plain(description);
const ogImage = new URL(`/og/og-${locale}.png`, siteUrl).href;
const envNoindex = import.meta.env.PUBLIC_NOINDEX === 'true';
const noindex = Astro.props.noindex || (key ? isNoindex(key) : false) || !isActiveLocale(locale);
const robots = noindex || envNoindex ? 'noindex, nofollow' : 'index, follow';

// hreflang: alle Sprachfassungen dieser Seite + x-default (Research §5.1).
const hreflangs = key && isActiveLocale(locale) ? alternates(key).map((a) => ({ ...a, href: new URL(a.path, siteUrl).href })) : [];
const otherOgLocales = key
  ? locales.filter((l) => l !== locale && isActiveLocale(l) && pathFor(key, l)).map((l) => localeMeta[l].og)
  : [];

// Brotkrumen: Start › (Eltern) › Seite
const homeHref = pathFor('home', locale) ?? '/';
let crumbs: Crumb[] = [];
if (breadcrumbs?.length) {
  crumbs = [{ name: ui.home, href: homeHref }, ...breadcrumbs];
} else if (key && !isHome) {
  const chain: PageKey[] = [];
  for (let k: PageKey | undefined = key; k; k = parentOf(k)) chain.unshift(k);
  crumbs = [
    { name: ui.home, href: homeHref },
    ...chain.map((k) => ({ name: crumbOf(locale, k) ?? plain(title), href: pathFor(k, locale) ?? pathname })),
  ];
}

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    ...siteGraph(siteUrl, locale),
    webPageLd(siteUrl, locale, canonical, title, description, ogType === 'profile' ? 'ProfilePage' : 'WebPage'),
    ...(crumbs.length ? [breadcrumbLd(siteUrl, crumbs)] : []),
    ...jsonLd,
  ],
};
const review = content[locale].needsReview;
---
<!doctype html>
<html lang={meta.bcp47}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    {hreflangs.map((h) => <link rel="alternate" hreflang={h.hreflang} href={h.href} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f7f3ec" />
    <link rel="preload" href={manropeLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={meta.og} />
    {otherOgLocales.map((l) => <meta property="og:locale:alternate" content={l} />)}
    <meta property="og:site_name" content={site.brand.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.brand.name} – ${site.brand.descriptor[locale]}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a class="skip-link" href="#inhalt">{ui.skip}</a>
    <Header locale={locale} routeKey={key} />
    <main id="inhalt" tabindex="-1" data-review={review ? 'translation' : undefined}>
      {crumbs.length > 0 && <Breadcrumbs items={crumbs} label={ui.breadcrumbLabel} />}
      <slot />
    </main>
    <Footer locale={locale} routeKey={key} />
  </body>
</html>

<style is:global>
  main:focus { outline: none; }
</style>
